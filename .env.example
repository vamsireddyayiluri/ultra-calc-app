# Browser-visible URL for the python-backend FastAPI service.
# Local dev:
VITE_PLAN_BACKEND_URL=http://127.0.0.1:8000

# Production (see ultra-fin-calculator/.env.production, which `vite build` uses
# automatically - no need to set this manually in most setups):
# VITE_PLAN_BACKEND_URL=https://ultra-calc-python-backend.onrender.com
