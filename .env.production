# Loaded automatically by `vite build` (production mode) - overrides the
# local-dev value from .env. Only the plan-analysis backend URL is
# environment-specific; Firebase config stays the same across environments.
# python-backend deployed on a self-hosted VM (sslip.io gives this IP a
# usable HTTPS hostname without needing real DNS) - see python-backend/.env
# on that VM for its matching CORS_ALLOWED_ORIGINS.
VITE_PLAN_BACKEND_URL=https://150.136.150.254.sslip.io
